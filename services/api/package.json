{
  "name": "@healthcare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:baseline": "tsx scripts/db.ts baseline",
    "medical-data:encrypt": "tsx scripts/encrypt-medical-data.ts",
    "synthetic:doctors:import": "tsx scripts/import-synthetic-doctors.ts",
    "synthetic:doctors:remove": "tsx scripts/remove-synthetic-doctors.ts",
    "demo:seed": "tsx scripts/db.ts seed-demo",
    "demo:reset": "tsx scripts/db.ts reset-demo"
  },
  "dependencies": {
    "@healthcare/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.13",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
