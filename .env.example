# API service
NODE_ENV=development
API_HOST=localhost
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Comma-separated trusted proxy IP addresses/CIDRs; leave blank for direct local access.
# Never set this to *; only list proxies that overwrite forwarded client-IP headers.
TRUSTED_PROXY_ADDRESSES=

# PostgreSQL is required for authentication and user/session persistence.
# This URL uses the current local OS/database role and contains no password.
# If your local PostgreSQL role differs, change it in your ignored .env file.
DATABASE_URL=postgresql://localhost:5432/smart_healthcare

# Set true when serving the API over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Dedicated medical-data encryption keyring. Generate a unique key with
# `openssl rand -hex 32`; format is `key-id:64-hex-character-key`.
# Keep this separate from MFA/OTP keys, outside source control and the database.
# For rotation, list the new active key first and retain prior IDs until re-encryption.
MEDICAL_DATA_ENCRYPTION_KEYS=

# Required for Admin TOTP MFA. Generate a unique key with `openssl rand -hex 32`
# and add it to this ignored local .env. Back it up securely; losing it makes
# stored MFA seeds unreadable.

# Account verification, password recovery, and selected event notifications use email.
# Generate AUTH_OTP_PEPPER with `openssl rand -hex 32`. Configure SMTP privately;
# SMTP_USER and SMTP_PASSWORD are optional but must be supplied together.
AUTH_OTP_PEPPER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Smart Healthcare


# Optional server-side OAuth login. Register these exact callback URLs with each provider:
# ${API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
# ${API_PUBLIC_URL}/api/v1/auth/oauth/facebook/callback
API_PUBLIC_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Pin the Meta Graph API version used for the token and profile endpoints.
FACEBOOK_GRAPH_API_VERSION=v26.0

# Optional LiveKit video provider. Video appointments can still be scheduled
# without these values; room access will report unavailable until all are set.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TELECONSULTATION_JOIN_WINDOW_MINUTES=15

# Optional rule-based recommendations for approved doctors with open slots.
# Disabled by default; never required for browsing or booking.
DOCTOR_RECOMMENDATIONS_ENABLED=false

# Private appointment documents remain outside the public web root.
DOCUMENT_STORAGE_DIR=.private-documents
DOCUMENT_MAX_BYTES=10000000
